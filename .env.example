# ============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: .env is gitignored - sensitive data will NOT be committed
# 
# Command to create:
#   cp .env.example .env
#   # Then edit .env with your actual credentials
# ============================================================================

# --- LOGGING ---
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# --- DATABASE ---
SQLITE_DB_PATH=/data/devops.db
# Creates /data/devops.db in your system
# Windows: Can be C:\data\devops.db or any other path
# Linux/Mac: /data/devops.db or /opt/devops/devops.db

# --- PTERODACTYL PANEL ---
PTERODACTYL_PANEL_URL=https://your-panel.example.com
# Example: https://pterodactyl.example.com
# The base URL of your Pterodactyl Panel installation

PTERODACTYL_API_KEY=your_pterodactyl_application_api_key_here
# IMPORTANT: Use APPLICATION KEY, not CLIENT KEY
# How to get it:
#   1. Login to Pterodactyl Panel
#   2. Go to Admin > API > Application API
#   3. Create new application API token
#   4. Copy the token here

# --- GOOGLE DRIVE BACKUP ---
GDRIVE_CREDENTIALS_PATH=config/google-service-account.json
# Path to your Google Service Account JSON file
# IMPORTANT: This file is gitignored - add it manually!
# 
# How to get it:
#   1. Go to Google Cloud Console
#   2. Create a Service Account
#   3. Create a JSON key file
#   4. Download and save to config/google-service-account.json
#   5. Share Google Drive folder with service account email
#      (service-account@project.iam.gserviceaccount.com)

GDRIVE_FOLDER_NAME=Minecraft-Backups
# Name of the folder in Google Drive where backups will be stored
# Folder structure will be: Minecraft-Backups/{server_name}/{YYYY-MM-DD}/

# --- NOTIFICATIONS (DISCORD) ---
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_token
# Optional: Discord webhook for backup notifications
# How to get it:
#   1. In Discord server, go to Settings > Webhooks
#   2. Create New Webhook
#   3. Copy the webhook URL
#   4. Leave empty if you don't want Discord notifications

# --- BACKUP SETTINGS ---
BACKUP_TIMEOUT_BASE_MINUTES=30
# Base timeout for backup operations (in minutes)
# Actual timeout = base + (1 minute per GB of backup)

BACKUP_MAX_CONCURRENT=3
# Maximum number of concurrent backups
# Recommended: 2-4 depending on server resources

BACKUP_CHUNK_SIZE_MB=256
# Google Drive upload chunk size (in MB)
# Larger = faster for big files, but more RAM usage
# Recommended: 256MB (supports files up to 40GB+)

# --- RETENTION POLICY ---
RETENTION_MAX_AGE_DAYS=30
# Delete backups older than this many days

RETENTION_MAX_COUNT_FULL=5
# Keep at most this many full backups per server

RETENTION_MAX_COUNT_INCREMENTAL=10
# Keep at most this many incremental backups per server

# --- API SERVER ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
# API_RELOAD=true for development (auto-reload on code changes)

# --- DOCKER ---
DOCKER_BACKUP_DIR=/backups
# Directory inside container for temporary backup files
# Mounted volume path
